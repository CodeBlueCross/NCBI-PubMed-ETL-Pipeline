{
  "taskGroups": [
    {
      "taskSpec": {
        "runnable": {
          "container": {
            "imageUri": "gcr.io/physicianscopilot/pubmed-vectorizer:latest",
            "entrypoint": "",
            "commands": [
              "python",
              "run_pubmed_pipeline.py"
            ]
          }
        },
        "environment": {
          "variables": {
            "GCS_BUCKET": "pcp-pubmed-articles-store",
            "QDRANT_URL": "https://qdrant-581583863729.us-central1.run.app",
            "GCP_PROJECT_ID": "physicianscopilot",
            "GCP_LOCATION": "us-central1",
            "GCS_CREDENTIALS": "/app/gcs_service_account.json"
          }
        },
        "maxRetryCount": 3,
        "maxRunDuration": "3600s"
      },
      "taskCount": 10,
      "parallelism": 5
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "policy": {
          "machineType": "e2-standard-4",
          "provisioningModel": "STANDARD"
        }
      }
    ]
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}